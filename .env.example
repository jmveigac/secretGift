# Copy to .env privately and configure your SMTP provider.
# Sending is blocked unless APP_MODE is exactly test or production.
APP_MODE=test
TEST_EMAIL=pruebas@example.invalid
FROM='"Organizador" <organizador@example.invalid>'
HOST=smtp.example.invalid
PORT=587
MAILUSER=
MAILPWD=
# CLI only:
SUBJECT='Amigo invisible'
